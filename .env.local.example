# Copy to .env.local and fill in ONE delivery method.
#
# Every contact-form submission is emailed to info@cmngproperty.com
# (site.email). Set CONTACT_TO to override the destination.
#
# The first method configured wins: SMTP, then Mailgun, then Resend, then
# Formspree.
#
# In development, leaving all of these blank logs the enquiry to the server
# and still returns success, so the form is usable on a fresh clone.
# In production, leaving them blank makes the form return an error — a form
# that silently swallows enquiries is worse than one that admits it is broken.

# --- Option 1: SMTP (what the other sites on this server use) ----------
# These variable names match foonhay's, so a working block copies across.
# Mailtrap live sending: host live.smtp.mailtrap.io, port 587, user "api"
# (literally the word "api"), pass = your Mailtrap API token.
# Also works with Google Workspace, Microsoft 365 or Mailgun's SMTP endpoint.
SMTP_FROM=noreply@cmngproperty.com
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=api
SMTP_PASS=

# --- Option 2: Mailgun HTTP API ----------------------------------------
# MAILGUN_DOMAIN is the verified sending domain, e.g. mg.cmngproperty.com.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU-region accounts only; a EU key against the US endpoint returns 401.
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# --- Option 3: Resend --------------------------------------------------
RESEND_API_KEY=

# --- Option 4: Formspree ----------------------------------------------
# The part after /f/ in your endpoint URL. Server-side only, so the ID is
# never shipped to the browser.
FORMSPREE_ID=

# --- Shared ------------------------------------------------------------
# Where enquiries land. Defaults to site.email (info@cmngproperty.com).
CONTACT_TO=
# Alias for SMTP_FROM, if you prefer the clearer name. Either works.
CONTACT_FROM=
