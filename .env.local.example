# Copy to .env.local and fill in ONE delivery method.
#
# Optional settings are commented out on purpose. A bare `NAME=` sets the
# variable to an empty string rather than leaving it unset; the code treats
# blank as unset, but leave them commented so it never matters.

# --- Option 1: SMTP — same approach as the other sites on this server ---
#
# Mailtrap sells two different products with different credentials. Taking
# them from the wrong tab gives you something that silently sends nothing:
#
#              Email Testing (sandbox)      Email Sending (live)
#   host       sandbox.smtp.mailtrap.io     live.smtp.mailtrap.io
#   port       2525                         587
#   user       random per-inbox string      literally "api"
#   pass       per-inbox password           your API token
#
# Sandbox captures mail in a web inbox and delivers nothing. Live actually
# sends, but only from a domain you have verified with Mailtrap.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=api
# SMTP_PASS=

# The sender. This must be a real address on a domain verified with the
# provider — NOT SMTP_USER, which on Mailtrap live is the literal string
# "api" and would produce "From: api", which Mailtrap rejects.
SMTP_FROM=noreply@cmngproperty.com

# Where enquiries land. Defaults to site.email (info@cmngproperty.com).
# ADMIN_EMAIL is accepted as an alias, matching the sibling sites.
# CONTACT_TO=
# ADMIN_EMAIL=

# SMTP_SECURE is a string, compared to "true". It is false on 587 (the
# connection opens plaintext and upgrades via STARTTLS) and true only on 465.
# Setting true on 587 hangs until the connection times out.

# --- Option 2: Mailgun HTTP API ----------------------------------------
# Useful if outbound 587 is ever firewalled, since this goes over 443.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=https://api.eu.mailgun.net   # EU accounts only

# --- Option 3: Resend --------------------------------------------------
# RESEND_API_KEY=

# --- Option 4: Formspree -----------------------------------------------
# FORMSPREE_ID=
