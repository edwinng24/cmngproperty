# Copy to .env.local and fill in ONE delivery method.
#
# Every contact-form submission is emailed to info@cmngproperty.com
# (site.email). Set CONTACT_TO to override the destination.
#
# In development, leaving all of these blank logs the enquiry to the server
# and still returns success, so the form is usable on a fresh clone.
# In production, leaving them blank makes the form return an error — a form
# that silently swallows enquiries is worse than one that admits it is broken.

# --- Option 1: your own mailbox over SMTP (recommended) ----------------
# Works with Google Workspace, Microsoft 365, or whoever hosts mail for
# cmngproperty.com. For Google Workspace use an App Password, not the
# account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@cmngproperty.com
SMTP_PASS=

# --- Option 2: Resend --------------------------------------------------
# https://resend.com — verify the domain, then create an API key.
RESEND_API_KEY=

# --- Option 3: Formspree ----------------------------------------------
# The part after /f/ in your endpoint URL: https://formspree.io/f/<id>
# Server-side only, so the ID is never shipped to the browser.
FORMSPREE_ID=

# --- Shared ------------------------------------------------------------
# Envelope sender. Must be a mailbox you are allowed to send as, or the
# message will be rejected or fail SPF at the far end.
CONTACT_FROM="CMNG Property <info@cmngproperty.com>"
# Override the destination. Defaults to site.email.
CONTACT_TO=
